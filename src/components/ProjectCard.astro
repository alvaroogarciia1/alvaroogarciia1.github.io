---
import type { Project } from "../data/projects";

import { getTranslation } from "../i18n";

interface Props {
  project: Project;
  lang: "en" | "es";
}

const { project, lang } = Astro.props;

const t = getTranslation(lang);
---

<article
  class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6 transition hover:border-sky-500"
>
  <h3 class="text-2xl font-bold">{project.title}</h3>

  <p class="mt-1 text-sky-400">
    {project.subtitle[lang]}
  </p>

  <p class="mt-4 text-zinc-400">
    {project.description[lang]}
  </p>

  <div class="mt-5 flex flex-wrap gap-2">
    {
      project.tech.map((tech) => (
        <span class="rounded-full bg-zinc-800 px-3 py-1 text-sm text-zinc-300">
          {tech}
        </span>
      ))
    }
  </div>

  <div class="mt-6 flex gap-4">
    <a
      href={project.github}
      target="_blank"
      class="text-sky-400 hover:text-sky-300"
    >
      {t.projects.repository}
    </a>

    {
      project.demo && (
        <a
          href={project.demo}
          target="_blank"
          class="text-sky-400 hover:text-sky-300"
        >
          {t.projects.demo}
        </a>
      )
    }
  </div>
</article>

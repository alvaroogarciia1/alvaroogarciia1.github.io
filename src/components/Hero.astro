---
import { getTranslation } from "../i18n";
import { profile } from "../data/profile";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const t = getTranslation(lang);

const cvUrl = profile.cv[lang];
---

<section class="relative flex items-center overflow-hidden py-16 md:py-20">
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(14,165,233,0.18),_transparent_35%)]"
  >
  </div>

  <div
    class="relative mx-auto grid w-full max-w-7xl items-center gap-12 px-8 py-10 lg:grid-cols-2"
  >
    <div>
      <p class="mb-4 font-semibold text-sky-400">
        {t.hero.greeting}
      </p>

      <h1
        class="max-w-3xl text-5xl font-black leading-tight tracking-tight md:text-7xl"
      >
        {profile.name}
      </h1>

      <h2 class="mt-4 text-2xl text-zinc-200 md:text-3xl">
        {profile.title[lang]}
      </h2>

      <p class="mt-4 max-w-2xl text-lg leading-8 text-zinc-400">
        {profile.subtitle[lang]}
      </p>

      <div class="mt-6">
        <a
          href={cvUrl}
          target="_blank"
          class="rounded-xl bg-sky-500 px-6 py-3 font-semibold hover:bg-sky-400"
        >
          {t.hero.downloadCV}
        </a>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <div
        class="rounded-full bg-gradient-to-br from-sky-500/40 to-zinc-800 p-1 shadow-2xl"
      >
        <img
          src={profile.photo}
          alt="Profile picture"
          class="h-72 w-72 rounded-full object-cover md:h-88 md:w-88"
        />
      </div>
    </div>
  </div>
</section>

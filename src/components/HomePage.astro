---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import { projects } from "../data/projects";
import { getTranslation } from "../i18n";
import Navbar from "./Navbar.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { profile } from "../data/profile";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
const t = getTranslation(lang);
---

<Layout title={profile.name} lang={lang}>
  <main>
    <Navbar lang={lang} />

    <Hero lang={lang} />

    <section id="about" class="mx-auto max-w-7xl px-8 py-14">
      <h2 class="text-3xl font-bold">{t.about.title}</h2>

      <div class="mt-4 max-w-4xl space-y-4 text-lg text-zinc-400">
        <p>{t.about.p1}</p>
        <p>{t.about.p2}</p>
        <p>{t.about.p3}</p>

        <p
          class="rounded-2xl border border-sky-500/30 bg-sky-500/10 p-5 text-sky-200"
        >
          {t.about.status}
        </p>
      </div>
    </section>

    <section id="projects" class="mx-auto max-w-7xl px-8 py-14">
      <div class="flex items-end justify-between gap-6">
        <div>
          <h2 class="text-3xl font-bold">{t.projects.title}</h2>
          <p class="mt-3 max-w-2xl text-zinc-400">{t.projects.description}</p>
        </div>

        <a
          href={lang === "es" ? "/projects-es" : "/projects"}
          class="hidden rounded-xl border border-zinc-700 px-5 py-3 hover:bg-zinc-900 md:block"
        >
          {t.projects.button}
        </a>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {
          projects.slice(0, 3).map((project) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
              <h3 class="text-xl font-bold">{project.title}</h3>

              <p class="mt-1 text-sky-400">{project.subtitle[lang]}</p>

              <p class="mt-4 text-zinc-400">{project.description[lang]}</p>

              <div class="mt-5 flex flex-wrap gap-2">
                {project.tech.slice(0, 4).map((tech: string) => (
                  <span class="rounded-full bg-zinc-800 px-3 py-1 text-sm text-zinc-300">
                    {tech}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="tech" class="mx-auto max-w-7xl px-8 py-14">
      <h2 class="text-3xl font-bold">{t.tech.title}</h2>

      <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
          <h3 class="text-xl font-bold text-sky-400">{t.tech.languages}</h3>
          <p class="mt-3 text-zinc-400">Java · Python · C · TypeScript · SQL</p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
          <h3 class="text-xl font-bold text-sky-400">{t.tech.backend}</h3>
          <p class="mt-3 text-zinc-400">
            Spring Boot · Spring Security · REST APIs · Hibernate · JWT
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
          <h3 class="text-xl font-bold text-sky-400">{t.tech.frontend}</h3>
          <p class="mt-3 text-zinc-400">React · Next.js · TypeScript</p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
          <h3 class="text-xl font-bold text-sky-400">{t.tech.databases}</h3>
          <p class="mt-3 text-zinc-400">PostgreSQL · MySQL · Firebase</p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
          <h3 class="text-xl font-bold text-sky-400">{t.tech.tools}</h3>
          <p class="mt-3 text-zinc-400">
            Docker · Git · GitHub · Maven · Postman · Linux
          </p>
        </div>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-7xl px-8 py-14">
      <h2 class="text-3xl font-bold">{t.contact.title}</h2>

      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={`mailto:${profile.email}`}
          class="rounded-xl bg-sky-500 px-6 py-3 font-semibold hover:bg-sky-400"
        >
          Email
        </a>

        <a
          href={profile.linkedin}
          target="_blank"
          class="rounded-xl border border-zinc-700 px-6 py-3 hover:bg-zinc-900"
        >
          LinkedIn
        </a>

        <a
          href={profile.github}
          target="_blank"
          class="rounded-xl border border-zinc-700 px-6 py-3 hover:bg-zinc-900"
        >
          GitHub
        </a>
      </div>
    </section>
  </main>
</Layout>

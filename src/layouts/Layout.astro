---
import "../styles/global.css";

interface Props {
  title?: string;
  lang?: "en" | "es";
}

const { title = "Álvaro García-Caro Bartolomé", lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
  </head>

  <body class="bg-zinc-950 text-zinc-100">
    <slot />
  </body>
</html>
